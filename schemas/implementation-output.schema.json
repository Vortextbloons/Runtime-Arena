{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-arena.dev/schemas/implementation-output.schema.json",
  "title": "ImplementationOutput",
  "description": "Base shape for benchmark implementation outputs. Benchmark-specific fields are validated by the Go checker.",
  "type": "object",
  "required": ["benchmark", "version"],
  "properties": {
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "benchmark": {
            "const": "nbody"
          }
        }
      },
      "then": {
        "required": [
          "benchmark",
          "version",
          "bodyCount",
          "finalEnergy",
          "positionChecksum",
          "velocityChecksum"
        ],
        "properties": {
          "bodyCount": {
            "type": "integer",
            "minimum": 1
          },
          "finalEnergy": {
            "type": "number"
          },
          "positionChecksum": {
            "type": "string"
          },
          "velocityChecksum": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "benchmark": {
            "const": "shortest-path"
          }
        }
      },
      "then": {
        "required": ["benchmark", "version", "results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["queryId", "distance", "path"],
              "properties": {
                "queryId": {
                  "type": "integer"
                },
                "distance": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "benchmark": {
            "const": "aggregation"
          }
        }
      },
      "then": {
        "required": [
          "benchmark",
          "version",
          "recordCount",
          "totalQuantity",
          "totalValueMinorUnits",
          "categories",
          "topAccounts",
          "checksum"
        ],
        "properties": {
          "recordCount": {
            "type": "integer",
            "minimum": 0
          },
          "totalQuantity": {
            "type": "integer"
          },
          "totalValueMinorUnits": {
            "type": "integer"
          },
          "categories": {
            "type": "array"
          },
          "topAccounts": {
            "type": "array"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "benchmark": {
            "const": "word-frequency"
          }
        }
      },
      "then": {
        "required": ["benchmark", "version", "totalWords", "uniqueWords", "topWords", "checksum"],
        "properties": {
          "totalWords": { "type": "integer", "minimum": 0 },
          "uniqueWords": { "type": "integer", "minimum": 0 },
          "topWords": { "type": "array" },
          "checksum": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "benchmark": {
            "const": "record-sorting"
          }
        }
      },
      "then": {
        "required": ["benchmark", "version", "recordCount", "firstRecords", "lastRecords", "checksum"],
        "properties": {
          "recordCount": { "type": "integer", "minimum": 0 },
          "firstRecords": { "type": "array" },
          "lastRecords": { "type": "array" },
          "checksum": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "benchmark": {
            "const": "arena-exchange"
          }
        }
      },
      "then": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "benchmark",
          "version",
          "eventCount",
          "acceptedEventCount",
          "rejectedEventCount",
          "acceptedOrderCount",
          "rejectedOrderCount",
          "acceptedReplaceCount",
          "rejectedReplaceCount",
          "cancelledOrderCount",
          "tradeCount",
          "tradedQuantity",
          "tradedValue",
          "snapshotCount",
          "openOrderCount",
          "instrumentSummaries",
          "topAccounts",
          "bookChecksum",
          "accountChecksum",
          "tradeChecksum",
          "snapshotChecksum",
          "eventChecksum"
        ],
        "properties": {
          "benchmark": {
            "const": "arena-exchange"
          },
          "version": {
            "const": 1
          },
          "eventCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "acceptedEventCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rejectedEventCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "acceptedOrderCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rejectedOrderCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "acceptedReplaceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rejectedReplaceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cancelledOrderCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tradeCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tradedQuantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tradedValue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "snapshotCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "openOrderCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "instrumentSummaries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "instrumentId",
                "minPrice",
                "maxPrice",
                "halted",
                "bestBid",
                "bestAsk",
                "lastTradePrice",
                "tradedQuantity",
                "tradedValue",
                "tradeCount",
                "bidLevelCount",
                "askLevelCount",
                "restingOrderCount"
              ],
              "properties": {
                "instrumentId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "minPrice": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "maxPrice": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "halted": { "type": "boolean" },
                "bestBid": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "bestAsk": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastTradePrice": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tradedQuantity": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "tradedValue": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "tradeCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "bidLevelCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "askLevelCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "restingOrderCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "topAccounts": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accountId",
                "tradedValue"
              ],
              "properties": {
                "accountId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "tradedValue": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "bookChecksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "accountChecksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tradeChecksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "snapshotChecksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "eventChecksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "benchmark": {
            "const": "matrix-multiplication"
          }
        }
      },
      "then": {
        "required": ["benchmark", "version", "dimension", "elementCount", "valueSum", "diagonalSum", "checksum"],
        "properties": {
          "dimension": { "type": "integer", "minimum": 1 },
          "elementCount": { "type": "integer", "minimum": 1 },
          "valueSum": { "type": "integer" },
          "diagonalSum": { "type": "integer" },
          "checksum": { "type": "string" }
        }
      }
    }
  ]
}
